DJANGO_SECRET_KEY=change-me-in-production
# DEBUG is off unless explicitly enabled. Leave it True for local development.
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,web

# Signing key for API tokens. Falls back to DJANGO_SECRET_KEY when unset — set it
# separately in production so the two can be rotated independently and a leak of
# one does not compromise the other.
JWT_SECRET_KEY=

POSTGRES_DB=django_init
POSTGRES_USER=django_init
POSTGRES_PASSWORD=django_init
POSTGRES_HOST=db
POSTGRES_PORT=5432

REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Channels group backend. Defaults to REDIS_URL. Must be Redis in any
# multi-process deployment — the in-memory layer does not cross processes.
CHANNEL_LAYER_URL=

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

LOG_LEVEL=INFO
# "console" (human-readable) or "json" (structured). Defaults to console when
# DEBUG is on, json otherwise.
LOG_FORMAT=console

# Production hardening — enable behind TLS.
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SESSION_COOKIE_SECURE=False
DJANGO_CSRF_COOKIE_SECURE=False
DJANGO_SECURE_HSTS_SECONDS=0
